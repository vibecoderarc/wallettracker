# AlphaGraph configuration. Copy to .env and fill in.
# NO SECRETS BELONG IN THIS FILE OR IN GIT.

ALPHAGRAPH_ENVIRONMENT=local

# shadow      = compute everything, send nothing (default, and the safe state)
# live_alerts = deliver notifications; also requires a destination below
ALPHAGRAPH_RUN_MODE=shadow

# fixture = deterministic synthetic world, zero cost, no network
# live    = real providers; refuses to start without a chain provider configured
ALPHAGRAPH_PROVIDER_MODE=fixture

ALPHAGRAPH_DATABASE_URL=sqlite+pysqlite:///./alphagraph.db
# Production: postgresql+psycopg://user:pass@localhost:5432/alphagraph

# Budget caps. The system degrades optional enrichment before critical ingestion.
ALPHAGRAPH_DAILY_BUDGET_USD=25
ALPHAGRAPH_MONTHLY_BUDGET_USD=600

# Provider credentials. Empty means unavailable — the system reduces coverage
# visibly rather than pretending to have data.
ALPHAGRAPH_SOLANA_RPC_URL=
ALPHAGRAPH_SOLANA_INDEXER_KEY=
ALPHAGRAPH_MARKET_DATA_KEY=
ALPHAGRAPH_PERPS_API_URL=
ALPHAGRAPH_BSC_RPC_URL=
ALPHAGRAPH_AI_PROVIDER_KEY=

# Notifications require BOTH run_mode=live_alerts AND this destination.
ALPHAGRAPH_NOTIFICATION_WEBHOOK=

ALPHAGRAPH_API_HOST=127.0.0.1
ALPHAGRAPH_API_PORT=8000
